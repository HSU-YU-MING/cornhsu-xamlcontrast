<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XamlContrast.Cli</RootNamespace>
    <AssemblyName>xamlcontrast</AssemblyName>

    <!-- dotnet tool:使用者敲的是乾淨的 `xamlcontrast`,套件掛 Cornhsu.* 前綴(規畫書第 11 節) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xamlcontrast</ToolCommandName>
    <PackageId>Cornhsu.XamlContrast</PackageId>
    <Version>0.1.0</Version>
    <Description>XamlContrast — static WCAG contrast audit for XAML source. Scans the whole project without launching the app and fails CI when text falls below AA.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XamlContrast.Core\XamlContrast.Core.csproj" />
  </ItemGroup>

</Project>
