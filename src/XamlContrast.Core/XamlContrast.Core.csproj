<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XamlContrast.Core</RootNamespace>
    <!-- 解析引擎:純 System.Xml.Linq,不依賴 WPF runtime —— Linux CI 也能跑 -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XamlContrast.Tests" />
  </ItemGroup>

  <!-- WinUI 的框架預設主題色(1.4)。由 microsoft/microsoft-ui-xaml 產生(MIT,見 THIRD-PARTY-NOTICES.md),產生方式見 WinUiThemeTests -->
  <ItemGroup>
    <EmbeddedResource Include="WinUiTheme.json" LogicalName="XamlContrast.Core.WinUiTheme.json" />
  </ItemGroup>

</Project>
