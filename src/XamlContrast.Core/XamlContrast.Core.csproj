<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XamlContrast.Core</RootNamespace>
    <!-- 解析引擎:純 System.Xml.Linq,不依賴 WPF runtime —— Linux CI 也能跑 -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XamlContrast.Tests" />
  </ItemGroup>

  <!-- WinUI 的框架預設主題色(1.4)。由 microsoft/microsoft-ui-xaml 產生(MIT,見 THIRD-PARTY-NOTICES.md),產生方式見 WinUiThemeTests -->
  <ItemGroup>
    <EmbeddedResource Include="WinUiTheme.json" LogicalName="XamlContrast.Core.WinUiTheme.json" />
  </ItemGroup>

  <!-- 第三方主題函式庫的內建色票(1.5)。各由那個函式庫自己的主題檔產生(都是 MIT,見 THIRD-PARTY-NOTICES.md),
       產生方式見 LibraryThemeTests。⚠ MahApps 不在這裡:它的主題檔是建置時產生的,見 LibraryThemes 的註解 -->
  <ItemGroup>
    <EmbeddedResource Include="WpfUiTheme.json" LogicalName="XamlContrast.Core.WpfUiTheme.json" />
    <EmbeddedResource Include="MaterialDesignTheme.json" LogicalName="XamlContrast.Core.MaterialDesignTheme.json" />
    <EmbeddedResource Include="HandyControlTheme.json" LogicalName="XamlContrast.Core.HandyControlTheme.json" />
  </ItemGroup>

</Project>
