<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XamlContrast demo — 刻意做壞的頁面 / intentionally broken on purpose">
    <Window.Resources>
        <!-- 刻意做壞 #3：Style 觸發態 hover 字色過淡（trigger-state failure） -->
        <Style x:Key="HoverBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#9A9A9A"/>
                </Trigger>
                <!-- 停用態：WCAG 1.4.3 豁免 → 計數回報、不評分（disabled-state exemption） -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource Bg}">
        <StackPanel Margin="24">
            <!-- 通過：主文字 × 主底色（passes AA in both themes） -->
            <TextBlock Foreground="{DynamicResource Fg}" FontSize="14" Text="正常文字 normal text"/>

            <!-- 刻意做壞 #1：兩主題都過淡（fails in BOTH themes — the palette itself is too weak） -->
            <TextBlock Foreground="{DynamicResource DimText}" FontSize="12" Text="太淡的次要文字 too dim"/>

            <!-- 刻意做壞 #2：寫死白字，深色過、淺色 1:1（hardcoded White — light theme 1:1） -->
            <Border Background="{DynamicResource Surface}" Padding="8">
                <TextBlock Foreground="White" FontSize="12" Text="寫死的白字 hardcoded white"/>
            </Border>

            <Button Style="{StaticResource HoverBtn}" Content="hover 我 hover me"/>

            <!-- 大字級：3.0 就夠（24px = 18pt → large-text threshold） -->
            <TextBlock Foreground="{DynamicResource Accent}" FontSize="24" Text="大標題 large heading"/>

            <!-- 裝飾元素：分隔線不適用文字對比（decorative — no text threshold） -->
            <Rectangle Fill="{DynamicResource Divider}" Height="1" Margin="0,12"/>

            <!-- ignore 註解：理由必填，壓掉會計入 suppressed（suppression needs a reason） -->
            <!-- xamlcontrast-ignore: 浮水印，刻意低對比 watermark, intentionally faint -->
            <TextBlock Foreground="{DynamicResource DimText}" FontSize="12" Text="草稿 DRAFT"/>
        </StackPanel>
    </Grid>
</Window>
