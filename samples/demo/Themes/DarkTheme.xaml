<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 示範色盤（深色）。與 LightTheme.xaml 成對，鍵集相同 → 自動偵測為主題配對 -->
    <SolidColorBrush x:Key="Bg" Color="#121212"/>
    <SolidColorBrush x:Key="Surface" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Fg" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="DimText" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Accent" Color="#3A78C3"/>
    <SolidColorBrush x:Key="Divider" Color="#333333"/>
</ResourceDictionary>
